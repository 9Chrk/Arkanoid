  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "*.documentation": "#555C77",
      // Garder seulement la couleur perso sur la doc générique,
      // pas sur les variables ou paramètres
      "parameter.documentation": "#ffffff", // blanc
      "variable.documentation": "#ffffff",  // blanc
      "property.documentation": "#ffffff"   // blanc
    }
  },
"editor.tokenColorCustomizations": {
  "textMateRules": [
    // Paramètres dans la docstring
    {
      "scope": [
        "comment.line.double-slash.documentation.cpp variable.parameter.cpp"
      ],
      "settings": { "foreground": "#555C77" }
    },
    // @brief, @param, etc.
    {
      "scope": [
        "keyword.other.documentation",
        "keyword.other.documentation.doxygen",
        "punctuation.definition.keyword.doxygen",
        "punctuation.definition.keyword",
        "storage.type.class.doxygen.cpp"
      ],
      "settings": { "foreground": "#555C77" }
    }
  ]
}

}